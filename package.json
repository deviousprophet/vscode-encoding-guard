{
  "name": "vscode-encoding-guard",
  "displayName": "Encoding Guard",
  "publisher": "deviousprophet",
  "description": "Protects you from wrong encodings — Automatically detects and applies the correct file encoding on open.",
  "version": "1.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deviousprophet/vscode-encoding-guard"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "encoding-guard.detectEncoding",
        "title": "Detect Encoding",
        "category": "Encoding Guard"
      },
      {
        "command": "encoding-guard.setExtensionEncoding",
        "title": "Set Extension Encoding...",
        "category": "Encoding Guard"
      },
      {
        "command": "encoding-guard.setFileEncoding",
        "title": "Set File Encoding...",
        "category": "Encoding Guard"
      },
      {
        "command": "encoding-guard.convertFileEncoding",
        "title": "Convert File to Encoding...",
        "category": "Encoding Guard"
      },
      {
        "command": "encoding-guard.openSettings",
        "title": "Open Encoding Guard Settings",
        "category": "Encoding Guard"
      }
    ],
    "submenus": [
      {
        "id": "encoding-guard/context",
        "label": "Encoding Guard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "encoding-guard/context",
          "group": "encoding@1",
          "when": "resourceScheme == file && !explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "submenu": "encoding-guard/context",
          "group": "encoding@1",
          "when": "resourceScheme == file"
        }
      ],
      "encoding-guard/context": [
        {
          "command": "encoding-guard.setExtensionEncoding",
          "group": "1_config@1"
        },
        {
          "command": "encoding-guard.setFileEncoding",
          "group": "1_config@2"
        },
        {
          "command": "encoding-guard.convertFileEncoding",
          "group": "1_config@3"
        },
        {
          "command": "encoding-guard.openSettings",
          "group": "2_settings@1"
        }
      ]
    },
    "configuration": {
      "title": "Encoding Guard",
      "properties": {
        "encoding-guard.patternMap": {
          "type": "object",
          "scope": "resource",
          "description": "Map file patterns to encoding. Keys can be exact workspace-relative paths (e.g. \"data/report.csv\"), glob patterns (e.g. \"**/*.csv\", \"src/*.xml\"), or extension shorthand (e.g. \".csv\"). Matching priority is exact paths, then globs (more specific first), then extensions. Files with <?xml ... encoding=\"...\"?> declarations are handled automatically.",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "encoding-guard.enableHeuristicFallback": {
          "type": "boolean",
          "scope": "resource",
          "description": "When enabled, uses jschardet to guess encoding for files that have no patternMap entry and no XML declaration. Disabled by default because heuristic detection can misfire on short or binary-adjacent files.",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/iconv-lite": "^0.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "editorconfig": "^3.0.2",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4"
  }
}
