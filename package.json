{
  "name": "vscode-encodex",
  "displayName": "Encodex",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "encodex.detectAndSuggest",
        "title": "Encodex: Detect and Suggest Encoding"
      },
      {
        "command": "encodex.openEncodingMenu",
        "title": "Encodex: Open Change Encoding Menu"
      }
    ]
    ,
    "configuration": {
      "title": "Encodex",
      "properties": {
        "encodex.rules": {
          "type": "array",
          "description": "List of rules mapping file globs to encodings. Each entry should be an object with 'glob' and 'encoding' properties.",
          "default": []
        },
        "encodex.mode": {
          "type": "string",
          "description": "Operation mode for automatic encoding actions: manual, safe, or auto.",
          "default": "manual",
          "enum": ["manual", "safe", "auto"]
        },
        "encodex.autoApply": {
          "type": "boolean",
          "description": "When true and mode is 'auto', attempt to open the change-encoding UI automatically when a mismatch is detected.",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
